{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chandol.wav",
  "version": "0.1.0",
  "identifier": "dev.pages.chandolwav.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "chandol.wav",
        "width": 1150,
        "height": 780,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 420,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "Every chandol & BoyWithUke song in one place",
    "longDescription": "A music player for every chandol and BoyWithUke song: released albums and EPs, unreleased tracks, every version, synced lyrics and playlists.",
    "category": "Music",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-pulseaudio",
          "libwebkit2gtk-4.1-0"
        ]
      }
    }
  }
}